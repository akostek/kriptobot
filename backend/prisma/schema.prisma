generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Trade {
  id        Int      @id @default(autoincrement())
  symbol    String   
  side      String   
  price     Float
  amount    Float
  reason    String   
  status    String   // "OPEN", "CLOSED"
  pnl       Float?   // Profit and Loss when closed
  sellPrice Float?
  closedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TradeLog {
  id        Int      @id @default(autoincrement())
  symbol    String
  action    String   
  reasoning String   
  price     Float
  createdAt DateTime @default(now())
}

model Setting {
  id               String   @id @default("1")
  binanceKey       String?
  binanceSecret    String?
  openaiKey        String?
  aiModel          String   @default("gpt-4o-mini")
  symbol           String   @default("BTC/USDT") // Kept for default fallback, though we use CoinSettings now
  tradeAmount      Float    @default(100.0)
  isManualApproval Boolean  @default(true)
  maxTradesPerDay  Int      @default(5)
  scanInterval     Int      @default(5) // Minutes
  updatedAt        DateTime @updatedAt
}

model ApprovalQueue {
  id          Int      @id @default(autoincrement())
  symbol      String
  action      String   // "BUY" or "SELL"
  reasoning   String
  price       Float
  amount      Float
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt   DateTime @default(now())
  processedAt DateTime?
}

model CoinSettings {
  symbol       String   @id // e.g. "BTC/USDT"
  isActive     Boolean  @default(true) // false = Quarantined
  lastScanned  DateTime?
}

model BalanceHistory {
  id        Int      @id @default(autoincrement())
  balance   Float
  date      DateTime @default(now()) // Stored once per day or per hour
}
